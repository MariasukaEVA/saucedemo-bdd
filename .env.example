# Copy this to .env and fill in values for local overrides
# Environment: uat | dev | sit | prod
ENV=uat

# Override base URL (optional — defaults come from src/config/environments/*.env)
# BASE_URL=https://www.saucedemo.com

# Viewport: desktop | mobile
VIEWPORT=desktop

# Locale: en | fr
LOCALE=en

# Headless mode: true | false
HEADLESS=true

# Slow motion in ms (useful for debugging)
SLOW_MO=0
