{
  "name": "saucedemo-bdd",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD + TypeScript enterprise test automation POC",
  "scripts": {
    "test": "cucumber-js",
    "test:uat": "ENV=uat cucumber-js",
    "test:dev": "ENV=dev cucumber-js",
    "test:sit": "ENV=sit cucumber-js",
    "test:prod": "ENV=prod cucumber-js",
    "test:smoke": "ENV=uat cucumber-js --tags @smoke",
    "test:regression": "ENV=uat cucumber-js --tags @regression",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:html": "node scripts/generate-html-report.js",
    "tsc:check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "allure-cucumberjs": "^3.0.0",
    "eslint": "^8.57.0",
    "multiple-cucumber-html-reporter": "^3.7.0",
    "playwright": "^1.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
